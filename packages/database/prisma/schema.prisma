// Prisma schema: https://www.prisma.io/docs/orm/prisma-schema
//
// Only the auth models ship with the starter. We will design the ERP data model together in the workshop.
// After adding/changing a model run:  pnpm db:migrate --name <describe-the-change>

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  ADMINISTRATOR
  PURCHASING_OFFICER
  STORE_EMPLOYEE
  MANAGER
}

/// Why a stock balance changed. OPENING is the seeded starting balance, RECEIPT raises it,
/// SALE lowers it, ADJUSTMENT is a manual correction.
enum MovementType {
  OPENING
  RECEIPT
  SALE
  ADJUSTMENT
}

model Store {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  users         User[]
  storeProducts StoreProduct[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Supplier {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id   String @id @default(cuid())
  sku  String @unique
  name String

  category String
  unit     String
  /// Selling price in integer minor units (satang): 12500 = ฿125.00. Avoids floating-point drift.
  sellingPriceMinor Int
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  storeProducts StoreProduct[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
}

/// A store-scoped row for a product. Carries the per-store reorder threshold (MD-01) and is the
/// row later stock balances attach to. Unique per (store, product) so a product can hold a
/// different threshold in each store.
model StoreProduct {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id])
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  /// The reorder threshold for this product in this store. Non-negative (MD-02), whole units.
  reorderThreshold Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([storeId, productId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// Written by hashPassword() from @erp/database. Never returned by the API.
  passwordHash String
  role         Role     @default(STAFF)
  /// The store this user is assigned to. Store scope is derived from this, never from request input.
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  auditLogs      AuditLog[]
}

/// The current stock balance of a product in a store (US-14: opening plus every successful
/// movement). One row per (store, product). `quantity` is whole and a database CHECK constraint
/// (added in the migration) refuses to let it go negative (INV-03). `version` is bumped on every
/// update and used as a guard so a concurrent update cannot be lost (INV-04).
model StockBalance {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      @default(0)
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
}

/// An immutable record of one stock change (INV-02, US-13). It names the product and store, the
/// signed quantity change, the balance before and after, why it changed, the source document that
/// drove it, who posted it, and when. It has no `updatedAt`: once written it is never edited or
/// deleted. Every stock change in the product goes through this model.
///
/// `productNameSnapshot` and `sellingPriceMinorSnapshot` are the product's name and selling price
/// at the moment this movement was recorded (the shared "historical fidelity" rule in TOR 4.3:
/// changes to master data must never alter the names, prices, or details already recorded in
/// historical documents). They are written once, at posting time, from the live `Product` row and
/// never updated afterwards, so a later edit to the product's name or price leaves every existing
/// movement showing exactly what it recorded then.
model StockMovement {
  id                        String       @id @default(cuid())
  storeId                   String
  store                     Store        @relation(fields: [storeId], references: [id])
  productId                 String
  product                   Product      @relation(fields: [productId], references: [id])
  quantityChange            Int
  balanceBefore             Int
  balanceAfter              Int
  movementType              MovementType
  sourceDocument            String
  productNameSnapshot       String
  sellingPriceMinorSnapshot Int
  actorId                   String
  actor                     User         @relation(fields: [actorId], references: [id])
  createdAt                 DateTime     @default(now())

  @@index([storeId, productId])
}

/// A cross-cutting audit trail entry (NFR-03): who acted, what source document drove the action,
/// and its outcome, with a timestamp. Established by ticket #17 for manager stock adjustments;
/// the sibling actions NFR-03 also names (purchase order approvals, goods receipts, sales) write
/// their own rows the same way. Written independently of whatever transaction the audited action
/// ran in, so a rejected action (which rolls its own transaction back) still leaves an entry.
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String
  actor          User     @relation(fields: [actorId], references: [id])
  /// What was audited, e.g. "STOCK_ADJUSTMENT". Free text: each audited action names its own.
  action         String
  /// The document or reason that drove the action (a manual adjustment's mandatory reason, a PO
  /// number, a receipt number).
  sourceDocument String
  /// The result, e.g. "SUCCESS" or "REJECTED". Free text: each audited action names its own.
  outcome        String
  createdAt      DateTime @default(now())

  @@index([action, createdAt])
}
